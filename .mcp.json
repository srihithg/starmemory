{
  "mcpServers": {
    "starmemory": {
      "command": "sh",
      "args": [
        "./cli/run-node.sh",
        "./cli/mcp-server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "STARMEMORY_DB_PATH",
        "STARMEMORY_INDEX_PATH",
        "STARMEMORY_TEXT_INDEX_PATH",
        "STARMEMORY_MODEL_CACHE_PATH",
        "STARMEMORY_ARCHIVE_PATH",
        "STARMEMORY_COWORK_PATH",
        "STARMEMORY_FORGOTTEN_PATH",
        "STARMEMORY_LOG_PATH",
        "STARMEMORY_TTL_DAYS"
      ]
    }
  }
}
